{
  "name": "repo-manager",
  "main": "src/env/cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Same joi browser-build problem the root wrangler.json pins - see its
  // own comment. Kept in step here so `wrangler dev` and any deploy run
  // from this directory bundle the same node build.
  "alias": {
    "@hapi/joi": "@hapi/joi/lib/index.js"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "durable_objects": {
    "bindings": [
      { "name": "REPO_MANAGER_DO", "class_name": "RepoManagerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoManagerDO"] }
  ],
  "vars": {
    "REPO_MANAGER_FORGE": "mem",
    "REPO_MANAGER_REPOS": "r1,voxgig/sdkgen",
    "REPO_MANAGER_GITHUB_USER": "maintainer1",
    "ADMIN_EMAIL": "admin@repo-manager.local",
    "ADMIN_PASSWORD": "demo-pass-123"
  },
  "observability": { "enabled": true }
}
