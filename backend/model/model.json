    "srv": {
      "inbox": {
        "api": {
          "web": {
            "active": true,
            "cors": {
              "active": false
            },
            "method": "POST",
            "path": {
              "area": "",
              "prefix": "/api/",
              "suffix": ""
            }
          }
        },
        "deps": {},
        "env": {
          "lambda": {
            "active": false,
            "handler": {
              "path": {
                "prefix": "dist/handler/lambda/",
                "suffix": ".handler"
              }
            },
            "kind": "standard",
            "timeout": 30
          }
        },
        "in": {
          "aim": {
            "inbox": {},
            "web": {
              "on": {
                "inbox": {
                  "$": {
                    "allow": true
                  }
                }
              }
            }
          }
        },
        "options": {
          "debug": true
        },
        "out": {}
      }
