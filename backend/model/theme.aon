
## Design theme (UI), controlled by the model. Each mode is a set of design
## tokens (colors, fonts, radius, effects) emitted as CSS variables
## (--vg-<token>) by @voxgig/build into web/src/theme.css. Override tokens
## per project in web/src/custom.css; add modes via the `theme:modes` hook.

mode: 'dark'          # default mode (MOCKUPS.md: dark-first)

modes: {
  light: {
    primary:       '#1f6feb'
    'primary-dark': '#1a5fd0'
    bg:            '#f5f7fa'
    surface:       '#ffffff'
    text:          '#1c2733'
    muted:         '#8b949e'
    border:        '#e3e8ee'
    'topbar-bg':   '#0d1b2a'
    'topbar-fg':   '#e6edf3'
    'accent-bg':   '#e7f0ff'
    font:          '15px/1.5 system-ui, sans-serif'
    radius:        '6px'
    'shadow-card': '0 6px 24px rgba(13,27,42,.10)'
  }

  # PLATFORM.md §5.1's real tokens (voxgig.com, confirmed against the live
  # site) - the scaffold's generic GitHub-dark blue never got swapped in.
  dark: {
    primary:       '#f2307a'
    'primary-dark': '#e70042'
    bg:            '#0f1117'
    surface:       '#2a3040'
    text:          '#e6edf3'
    muted:         '#8b95a7'
    border:        '#41506b'
    'topbar-bg':   '#0f1117'
    'topbar-fg':   '#e6edf3'
    'accent-bg':   '#f2307a22'
    success:       '#3fb950'
    'success-dark': '#2ea043'
    font:          '15px/1.5 system-ui, sans-serif'
    radius:        '6px'
    'shadow-card': '0 6px 24px rgba(0,0,0,.55)'
  }
}
