
# Seneca message patterns.
#
# main.msg is a LIST of message definitions, each carrying its pattern as
# DATA, an ordered list of single-pair maps, rather than as its position
# in a nested tree:
#
#   { pat: [{aim: forge}, {list: pr}] }
#
# THE BROWSER SURFACE: aim:web is the ONLY namespace the gateway accepts
# from a browser. Every message a browser may send is declared here as a
# web_ PROXY forwarding to the real service message — service messages
# (aim:forge, aim:inbox, ...) are never directly reachable from the
# network.

[
  # The contract every forge plugin (forge:github, forge:gitlab, forge:mem)
  # specialises. No service ever branches on which forge answers these.

  { pat: [{aim: forge}, {list: pr}] }
  { pat: [{aim: forge}, {list: issue}] }
  { pat: [{aim: forge}, {load: pr}] }
  { pat: [{aim: forge}, {open: pr}] }
  { pat: [{aim: forge}, {comment: issue}] }
  { pat: [{aim: forge}, {label: issue}] }
  { pat: [{aim: forge}, {assign: issue}] }
  { pat: [{aim: forge}, {close: issue}] }
  { pat: [{aim: forge}, {approve: pr}] }
  { pat: [{aim: forge}, {request: review}] }
  { pat: [{aim: forge}, {merge: pr}] }
  { pat: [{aim: forge}, {dismiss: alert}] }
  { pat: [{aim: forge}, {list: alert}] }
  { pat: [{aim: forge}, {list: check}] }
  { pat: [{aim: forge}, {get: info}] }


  # ---- inbox — the one semantic intent for this stage --------------------
  # service is what translates it into forge messages.

  { pat: [{aim: inbox}, {sync: item}] }
  { pat: [{aim: inbox}, {list: item}] }
  { pat: [{aim: inbox}, {dismiss: item}] }

  # SPEC §13.3: undo covers what a definition declares reversible - here,
  # dismiss and snooze (pure local state, no forge call). label/comment/
  # close/approve/merge changed forge state we can't reliably reverse
  # (no prior-labels capture, no comment-delete/review-dismiss modeled),
  # so those are excluded rather than offered and silently failing.
  { pat: [{aim: inbox}, {undo: item}] }

  # SPEC §12.4: rpm/reply - org-scoped templated responses, reachable from
  # the comment/close composer. Seeded with the spec's five named intents
  # on first use; list-only for now, no add/edit UI yet.
  { pat: [{aim: inbox}, {list: reply}] }

  # Raw fleet browse (Pull requests / Issues nav views) - every open PR or
  # issue, not the derived queue. No rpm/item behind these; read-only in
  # the UI.
  { pat: [{aim: inbox}, {list: pr}] }
  { pat: [{aim: inbox}, {list: issue}] }

  # The detail view for either kind of row above (item-backed or raw
  # browse) - PR-only for now, see the loose-ends memory note.
  { pat: [{aim: inbox}, {load: pr}] }

  # ---- item intents (SPEC §13.2 key bindings) -----------------------------
  # App-nouned, act on the WorkItem; each translates to the forge message(s)
  # below behind the gateway - the browser never posts aim:forge,* directly.

  { pat: [{aim: inbox}, {approve: item}] }
  { pat: [{aim: inbox}, {merge: item}] }
  { pat: [{aim: inbox}, {comment: item}] }
  { pat: [{aim: inbox}, {label: item}] }
  { pat: [{aim: inbox}, {close: item}] }
  { pat: [{aim: inbox}, {snooze: item}] }

  { pat: [{aim: web}, {on: inbox}, {sync: item}], file: './web_sync_item' }
  { pat: [{aim: web}, {on: inbox}, {list: item}], file: './web_list_item' }
  { pat: [{aim: web}, {on: inbox}, {dismiss: item}], file: './web_dismiss_item' }
  { pat: [{aim: web}, {on: inbox}, {undo: item}], file: './web_undo_item' }
  { pat: [{aim: web}, {on: inbox}, {list: reply}], file: './web_list_reply' }
  { pat: [{aim: web}, {on: inbox}, {approve: item}], file: './web_approve_item' }
  { pat: [{aim: web}, {on: inbox}, {merge: item}], file: './web_merge_item' }
  { pat: [{aim: web}, {on: inbox}, {comment: item}], file: './web_comment_item' }
  { pat: [{aim: web}, {on: inbox}, {label: item}], file: './web_label_item' }
  { pat: [{aim: web}, {on: inbox}, {close: item}], file: './web_close_item' }
  { pat: [{aim: web}, {on: inbox}, {snooze: item}], file: './web_snooze_item' }
  { pat: [{aim: web}, {on: inbox}, {list: pr}], file: './web_list_pr' }
  { pat: [{aim: web}, {on: inbox}, {list: issue}], file: './web_list_issue' }
  { pat: [{aim: web}, {on: inbox}, {load: pr}], file: './web_load_pr' }

]

