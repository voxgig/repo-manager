
sys: &: $.main.shape.ent


## Base system entities (used by the user/owner plugins).

sys: user: {
  field: {}
  valid: '$$': 'Open'
}

sys: login: {
  field: {}
  valid: '$$': 'Open'
}


## The work item — the one entity Stage 1 needs (SPEC.REPO-MANAGER.md §12).
## Derived, not user-created: a sync pass computes conditions true across the
## fleet and this stores one row per condition. Stage 1 populates exactly one
## kind, 'pr.review_requested', and only the 'open'/'done' states.

rpm: &: $.main.shape.ent

rpm: item: {
  field: {
    id: {
      label: 'ID'
      kind: String
    }
    org_id: {
      label: 'Org'
      kind: String
    }
    source: {
      label: 'Source'
      kind: String
    }
    repo: {
      label: 'Repo'
      kind: String
      valid: Skip
    }
    kind: {
      label: 'Kind'
      kind: String
    }
    title: {
      label: 'Title'
      kind: String
    }
    url: {
      label: 'URL'
      kind: String
      valid: Skip
    }
    actor: {
      label: 'Actor'
      kind: String
      valid: Skip
    }
    subject_id: {
      label: 'Subject ID'
      kind: String
    }
    priority: {
      label: 'Priority'
      kind: String
    }
    state: {
      label: 'State'
      kind: String
    }
    snooze_until: {
      label: 'Snooze until'
      kind: Number
      valid: Skip
    }
    first_seen: {
      label: 'First seen'
      kind: Number
    }
    first_response_at: {
      label: 'First response at'
      kind: Number
      valid: Skip
    }
    updated_at: {
      label: 'Updated at'
      kind: Number
    }
    digest: {
      label: 'Digest'
      kind: String
    }
    payload: {
      label: 'Payload'
      kind: Object
      valid: '$$': 'Open'
    }
  }
  valid: '$$': 'Open'
}


## Synced fleet data for the browse views (SPEC §9's "sync, not proxy").
## Not derived work items - the raw open PRs and issues as the forge reported
## them at the last sync. sync_item.ts already fetches all of this to run its
## detectors over, so storing it costs no extra forge calls, and list_pr.ts /
## list_issue.ts read it instead of re-polling every repo on every page load.

rpm: pr: {
  field: {
    id: {
      label: 'ID'
      kind: String
    }
    source: {
      label: 'Source'
      kind: String
    }
    repo: {
      label: 'Repo'
      kind: String
    }
    subject_id: {
      label: 'Subject ID'
      kind: String
    }
    title: {
      label: 'Title'
      kind: String
    }
    url: {
      label: 'URL'
      kind: String
      valid: Skip
    }
    actor: {
      label: 'Actor'
      kind: String
      valid: Skip
    }
    updated_at: {
      label: 'Updated at'
      kind: Number
      valid: Skip
    }
  }
  valid: '$$': 'Open'
}

rpm: issue: {
  field: {
    id: {
      label: 'ID'
      kind: String
    }
    source: {
      label: 'Source'
      kind: String
    }
    repo: {
      label: 'Repo'
      kind: String
    }
    subject_id: {
      label: 'Subject ID'
      kind: String
    }
    title: {
      label: 'Title'
      kind: String
    }
    url: {
      label: 'URL'
      kind: String
      valid: Skip
    }
    actor: {
      label: 'Actor'
      kind: String
      valid: Skip
    }
    updated_at: {
      label: 'Updated at'
      kind: Number
      valid: Skip
    }
  }
  valid: '$$': 'Open'
}

## One cell of the drift matrix (SPEC §14.3) per (repo, policy) - all four
## statuses, unlike the repo.drift ITEM kind above, which only exists for
## cells that actually drifted. syncDrift already computes every cell and
## discards the other three statuses; this keeps them.

rpm: driftcell: {
  field: {
    id: {
      label: 'ID'
      kind: String
    }
    source: {
      label: 'Source'
      kind: String
    }
    repo: {
      label: 'Repo'
      kind: String
    }
    policy_id: {
      label: 'Policy'
      kind: String
    }
    status: {
      label: 'Status'
      kind: String
    }
    why: {
      label: 'Why'
      kind: String
      valid: Skip
    }
    updated_at: {
      label: 'Updated at'
      kind: Number
      valid: Skip
    }
  }
  valid: '$$': 'Open'
}


